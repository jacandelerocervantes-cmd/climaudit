# All configuration comes from environment variables. No path or secret is hardcoded in code.
# Copy to .env (never commit .env) and load it with your shell or process manager.

# CP_ENV=dev serves /docs and /openapi.json; the default (prod) does not
CP_ENV=prod
# SQLite file; relative paths resolve against the process working directory.
CP_DB_PATH=./data/climaudit.db
# Directory with extra methodology profile JSON files (optional; built-in profiles always load).
CP_PROFILES_DIR=
# Role API keys as JSON: {"<key>": {"actor_id": "...", "role": "owner|verifier|registry|holder|admin|system|extractor"}}
CP_API_KEYS={}
# Ledger adapter: fake | direct | guardian
CP_LEDGER_MODE=fake
# Hedera testnet (only for CP_LEDGER_MODE=direct)
CP_HEDERA_NETWORK=testnet
CP_HEDERA_OPERATOR_ID=
CP_HEDERA_OPERATOR_KEY=
# Optional: a separate supply key if the token was created with one (the setup script uses the operator key)
CP_HEDERA_SUPPLY_KEY=
# Optional: override the public testnet mirror node URL
CP_HEDERA_MIRROR_URL=
CP_HCS_TOPIC_ID=
CP_HTS_TOKEN_ID=
# Optional LLM extraction (never needed for tests)
CP_ANTHROPIC_API_KEY=
CP_ANTHROPIC_MODEL=

# Guardian mode (CP_LEDGER_MODE=guardian). Credentials stay in your local .env, never in chat or git.
CP_GUARDIAN_URL=
CP_GUARDIAN_USERNAME=
CP_GUARDIAN_PASSWORD=
CP_GUARDIAN_POLICY_ID=
# Optional: block tags of the audit policy (defaults shown)
# CP_GUARDIAN_FORM_TAG=form
# CP_GUARDIAN_GRID_TAG=grid

# Advisory public-data cross-checks (distance, weather, land cover, registry). Off by default; needs the `geo` extra.
# CP_EXTERNAL_CHECKS=1 enables them. CP_REGISTRY_INDEX_PATH points to the file built by scripts/build_registry_index.py.
CP_EXTERNAL_CHECKS=0
CP_REGISTRY_INDEX_PATH=
# Optional overrides of the public endpoints (defaults: Open-Meteo archive API, ESA WorldCover v200 2021 on AWS)
CP_OPEN_METEO_URL=
CP_WORLDCOVER_URL=

# Optional limits and modes (defaults shown)
# CP_FORCE_SYNTHETIC=1      projects are always synthetic (demo mode); set 0 only with real, licensed data
# CP_MAX_UPLOAD_BYTES=10485760
