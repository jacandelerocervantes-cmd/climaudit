# Server-side only. Never prefix any of these with NEXT_PUBLIC_.
# Address of the ClimAudit API (the backend run with `uvicorn` or the demo launcher).
CP_API_URL=http://127.0.0.1:8000
# Demo role keys held by the server-side proxy; the browser never sees them. They must match CP_API_KEYS of the backend.
CP_KEY_OWNER=
CP_KEY_VERIFIER=
CP_KEY_REGISTRY=
CP_KEY_HOLDER=
CP_KEY_ADMIN=
